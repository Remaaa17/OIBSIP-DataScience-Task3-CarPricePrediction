   "source": [
    "## 10. Real-World Test Case: Predict Custom Car Price\n",
    "\n",
    "**Analysis Context:**\n",
    "\n",
    "This section demonstrates practical application of our trained models. We'll take a sample car from the test set, show its actual features, predict its price using both models, and compare predictions with the actual market price.\n",
    "\n",
    "This helps validate model performance on unseen data and shows how the model would perform in real-world scenarios where we need to estimate car values based on their specifications."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Select a random sample from test set\n",
    "import random\n",
    "random.seed(42)\n",
    "sample_idx = random.randint(0, len(X_test)-1)\n",
    "\n",
    "# Get the sample features and actual price\n",
    "sample_features = X_test.iloc[sample_idx]\n",
    "actual_price = y_test.iloc[sample_idx]\n",
    "\n",
    "print(\"=\"*70)\n",
    "print(\"SAMPLE CAR SPECIFICATIONS\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "# Display original (non-encoded) features if possible\n",
    "original_sample = df.iloc[y_test.index[sample_idx]]\n",
    "print(f\"\\nMake: {original_sample.get('Make', 'N/A')}\")\n",
    "print(f\"Model: {original_sample.get('Model', 'N/A')}\")\n",
    "print(f\"Year: {original_sample.get('Year', 'N/A')}\")\n",
    "print(f\"Kilometer: {original_sample.get('Kilometer', 'N/A')}\")\n",
    "print(f\"Fuel Type: {original_sample.get('Fuel Type', 'N/A')}\")\n",
    "print(f\"Transmission: {original_sample.get('Transmission', 'N/A')}\")\n",
    "print(f\"\\n{'='*70}\")\n",
    "print(f\"ACTUAL MARKET PRICE: ${actual_price:,.2f}\")\n",
    "print(\"=\"*70)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Make predictions using both models\n",
    "sample_features_reshaped = sample_features.values.reshape(1, -1)\n",
    "\n",
    "lr_prediction = lr_model.predict(sample_features_reshaped)[0]\n",
    "rf_prediction = rf_model.predict(sample_features_reshaped)[0]\n",
    "\n",
    "# Calculate prediction errors\n",
    "lr_error = abs(actual_price - lr_prediction)\n",
    "rf_error = abs(actual_price - rf_prediction)\n",
    "\n",
    "lr_error_pct = (lr_error / actual_price) * 100\n",
    "rf_error_pct = (rf_error / actual_price) * 100\n",
    "\n",
    "print(\"\\n\" + \"=\"*70)\n",
    "print(\"MODEL PREDICTIONS\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "print(f\"\\nLinear Regression Prediction: ${lr_prediction:,.2f}\")\n",
    "print(f\"  Error: ${lr_error:,.2f} ({lr_error_pct:.2f}%)\")\n",
    "print(f\"  {'UNDERESTIMATED' if lr_prediction < actual_price else 'OVERESTIMATED'} by ${abs(lr_error):,.2f}\")\n",
    "\n",
    "print(f\"\\nRandom Forest Prediction: ${rf_prediction:,.2f}\")\n",
    "print(f\"  Error: ${rf_error:,.2f} ({rf_error_pct:.2f}%)\")\n",
    "print(f\"  {'UNDERESTIMATED' if rf_prediction < actual_price else 'OVERESTIMATED'} by ${abs(rf_error):,.2f}\")\n",
    "\n",
    "print(f\"\\n{'='*70}\")\n",
    "if lr_error < rf_error:\n",
    "    print(f\"Best Prediction: Linear Regression (closer by ${abs(lr_error - rf_error):,.2f})\")\n",
    "else:\n",
    "    print(f\"Best Prediction: Random Forest (closer by ${abs(rf_error - lr_error):,.2f})\")\n",
    "print(\"=\"*70)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualization: Actual vs Predicted Comparison\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(15, 6))\n",
    "\n",
    "# Bar chart comparison\n",
    "models = ['Actual\\nPrice', 'Linear\\nRegression', 'Random\\nForest']\n",
    "prices = [actual_price, lr_prediction, rf_prediction]\n",
    "colors = ['#2ecc71', '#3498db', '#e74c3c']\n",
    "\n",
    "bars = axes[0].bar(models, prices, color=colors, edgecolor='black', linewidth=2, alpha=0.8)\n",
    "axes[0].set_ylabel('Price ($)', fontsize=12, fontweight='bold')\n",
    "axes[0].set_title('Price Comparison: Actual vs Predictions', fontsize=14, fontweight='bold')\n",
    "axes[0].grid(axis='y', alpha=0.3)\n",
    "\n",
    "# Add value labels on bars\n",
    "for bar, price in zip(bars, prices):\n",
    "    height = bar.get_height()\n",
    "    axes[0].text(bar.get_x() + bar.get_width()/2., height,\n",
    "                f'${price:,.0f}',\n",
    "                ha='center', va='bottom', fontweight='bold', fontsize=11)\n",
    "\n",
    "# Error comparison\n",
    "error_models = ['Linear\\nRegression', 'Random\\nForest']\n",
    "errors = [lr_error, rf_error]\n",
    "error_colors = ['#3498db', '#e74c3c']\n",
    "\n",
    "bars2 = axes[1].bar(error_models, errors, color=error_colors, edgecolor='black', linewidth=2, alpha=0.8)\n",
    "axes[1].set_ylabel('Absolute Error ($)', fontsize=12, fontweight='bold')\n",
    "axes[1].set_title('Prediction Error Comparison', fontsize=14, fontweight='bold')\n",
    "axes[1].grid(axis='y', alpha=0.3)\n",
    "\n",
    "# Add value labels on bars\n",
    "for bar, error, error_pct in zip(bars2, errors, [lr_error_pct, rf_error_pct]):\n",
    "    height = bar.get_height()\n",
    "    axes[1].text(bar.get_x() + bar.get_width()/2., height,\n",
    "                f'${error:,.0f}\\n({error_pct:.1f}%)',\n",
    "                ha='center', va='bottom', fontweight='bold', fontsize=10)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(\"\\nVisualization shows how close each model's prediction is to the actual price.\")\n",
    "print(\"Lower error bars indicate better prediction accuracy.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Test Multiple Samples\n",
    "\n",
    "Let's test both models on 5 random samples to see overall performance:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Test on 5 random samples\n",
    "n_samples = 5\n",
    "random_indices = random.sample(range(len(X_test)), n_samples)\n",
    "\n",
    "results = []\n",
    "\n",
    "print(\"=\"*90)\n",
    "print(\"TESTING ON 5 RANDOM SAMPLES\")\n",
    "print(\"=\"*90)\n",
    "\n",
    "for i, idx in enumerate(random_indices, 1):\n",
    "    sample = X_test.iloc[idx].values.reshape(1, -1)\n",
    "    actual = y_test.iloc[idx]\n",
    "    \n",
    "    lr_pred = lr_model.predict(sample)[0]\n",
    "    rf_pred = rf_model.predict(sample)[0]\n",
    "    \n",
    "    lr_err = abs(actual - lr_pred)\n",
    "    rf_err = abs(actual - rf_pred)\n",
    "    \n",
    "    results.append({\n",
    "        'Sample': i,\n",
    "        'Actual': actual,\n",
    "        'LR_Pred': lr_pred,\n",
    "        'LR_Error': lr_err,\n",
    "        'RF_Pred': rf_pred,\n",
    "        'RF_Error': rf_err\n",
    "    })\n",
    "    \n",
    "    print(f\"\\nSample {i}:\")\n",
    "    print(f\"  Actual Price: ${actual:,.2f}\")\n",
    "    print(f\"  LR Prediction: ${lr_pred:,.2f} (Error: ${lr_err:,.2f})\")\n",
    "    print(f\"  RF Prediction: ${rf_pred:,.2f} (Error: ${rf_err:,.2f})\")\n",
    "    print(f\"  Better Model: {'Linear Regression' if lr_err < rf_err else 'Random Forest'}\")\n",
    "\n",
    "# Calculate average errors\n",
    "avg_lr_error = np.mean([r['LR_Error'] for r in results])\n",
    "avg_rf_error = np.mean([r['RF_Error'] for r in results])\n",
    "\n",
    "print(\"\\n\" + \"=\"*90)\n",
    "print(\"AVERAGE PERFORMANCE ACROSS 5 SAMPLES\")\n",
    "print(\"=\"*90)\n",
    "print(f\"Linear Regression Average Error: ${avg_lr_error:,.2f}\")\n",
    "print(f\"Random Forest Average Error: ${avg_rf_error:,.2f}\")\n",
    "print(f\"\\nBest Overall Model: {'Linear Regression' if avg_lr_error < avg_rf_error else 'Random Forest'}\")\n",
    "print(\"=\"*90)"
   ]
  },
